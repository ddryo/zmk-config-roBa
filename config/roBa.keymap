#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        lang {
            bindings = <&to_layer_0 LC(SPACE)>;
            key-positions = <11 10>;
        };

        mission-control {
            bindings = <&kp LC(UP_ARROW)>;
            key-positions = <1 2 3>;
        };

        desktop-prev {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <1 2>;
        };

        desktop-next {
            bindings = <&kp LC(RIGHT_ARROW)>;
            key-positions = <2 3>;
        };

        scroll-up {
            bindings = <&msc SCRL_UP>;
            key-positions = <7 8>;
        };

        scroll_down {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <31 32>;
        };

        click {
            bindings = <&mkp MB1>;
            key-positions = <19 20>;
        };

        desktop {
            bindings = <&kp F11>;
            key-positions = <24 23 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        thumb_lt: thumb_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
        };

        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <300>;
            retro-tap;
            hold-trigger-key-positions = <5 6 7 8 9 17 18 19 20 21 29 30 31 32 33 41 42 40 39 38 37>;
            hold-trigger-on-release;
        };

        hmr_r: hmr_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <300>;
            retro-tap;
            hold-trigger-key-positions = <41 40 39 38 37 0 1 2 3 4 10 11 12 13 14 22 23 24 25 26 34 35 36>;
            hold-trigger-on-release;
        };

        // 新しいスクロール動作の追加

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W              &kp E                  &kp R                  &kp T                                                                &kp Y                  &kp U                 &lt 5 I                 &kp O               &kp P
&hrm_l LCTRL A  &hrm_l LEFT_ALT S  &hrm_l LEFT_COMMAND D  &hrm_l LEFT_SHIFT F    &kp G                   &kp LS(LG(NUMBER_4))      &kp LA(SPACE)      &kp H                  &hmr_r RIGHT_SHIFT J  &hmr_r RIGHT_COMMAND K  &hmr_r RIGHT_ALT L  &kp SEMICOLON
&kp Z           &kp X              &kp C                  &kp V                  &kp B                   &kp LG(C)                 &kp LG(V)          &kp N                  &kp M                 &kp COMMA               &kp DOT             &kp SLASH
&kp LG(Z)       &kp LG(LS(Z))      &kp LEFT_ALT           &thumb_lt 2 LC(SPACE)  &mt LEFT_COMMAND SPACE  &thumb_lt 1 TAB           &thumb_lt 1 ENTER  &thumb_lt 3 BACKSPACE                                                                    &kp ESC
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SYMBOL {
            bindings = <
&trans     &kp AT_SIGN  &kp HASH   &kp DOLLAR         &kp PERCENT                                    &kp CARET  &kp AMPS   &kp LBRC  &kp RBRC  &kp PIPE
&kp TILDE  &kp EXCL     &kp QMARK  &kp SQT            &kp STAR     &trans             &kp LG(LS(P))  &kp PLUS   &kp MINUS  &kp LPAR  &kp RPAR  &kp EQUAL
&trans     &kp LT       &kp GT     &kp DOUBLE_QUOTES  &none        &kt LG(LS(F))      &kp LG(P)      &none      &kp UNDER  &kp LBKT  &kp RBKT  &kp BSLH
&trans     &trans       &trans     &trans             &trans       &trans             &trans         &trans                                    &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                           &none   &kp N7  &kp N8  &kp N9  &kp N0
&kp KP_N0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &trans  &none   &kp N4  &kp N5  &kp N6  &kp N0
&kp KP_N0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &trans                       &trans  &none   &kp N1  &kp N2  &kp N3  &kp N0
&trans     &trans           &trans           &trans           &trans        &trans                       &trans  &trans                          &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &mkp MB4  &mkp MB5  &none      &kp F11                      &none     &kp LA(LEFT_ARROW)      &kp UP_ARROW    &kp LA(RIGHT_ARROW)      &kp ESCAPE
&kp LCTRL   &kp LALT  &kp LGUI  &kp LSHFT  &none    &trans      &trans  &kp HOME  &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END
&trans      &trans    &trans    &trans     &trans   &trans      &trans  &none     &kp LS(LG(LEFT_ARROW))  &none           &kp LS(LG(RIGHT_ARROW))  &trans
&trans      &trans    &trans    &mo 5      &trans   &trans      &trans  &trans                                                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        MOUSE {
            bindings = <
&mkp MB4  &mkp MB5  &trans  &trans    &trans                      &trans  &trans    &mkp MB3  &trans    &trans
&trans    &trans    &trans  &mkp MB1  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB1  &mkp MB2  &trans
&trans    &trans    &trans  &trans    &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans    &trans    &trans  &trans    &trans  &trans      &trans  &trans                                &trans
            >;
        };

        Function {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none    &none                            &none   &none   &none   &none   &none
&kp F1        &kp F2        &kp F3        &kp F4   &kp F5   &none      &none        &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11       &kp F12       &kp F13       &kp F14  &kp F15  &none      &bootloader  &none   &none   &none   &none   &none
&bt BT_CLR    &none         &none         &none    &none    &none      &none        &none                           &bt BT_CLR_ALL
            >;
        };
    };
};
