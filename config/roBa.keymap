#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
};

&lt { flavor = "hold-preferred"; };

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        mission-control {
            bindings = <&kp LC(UP_ARROW)>;
            key-positions = <11 12 13 10>;
        };

        desktop-prev {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <11 12 13>;
            timeout-ms = <50>;
        };

        desktop-next {
            bindings = <&kp LC(RIGHT_ARROW)>;
            key-positions = <13 12 14>;
            timeout-ms = <50>;
        };

        scroll-up {
            bindings = <&msc SCRL_UP>;
            key-positions = <7 8>;
            timeout-ms = <40>;
        };

        scroll_down {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <31 32>;
            timeout-ms = <40>;
        };

        click {
            bindings = <&mkp MB1>;
            key-positions = <19 18>;
            timeout-ms = <40>;
        };

        desktop {
            bindings = <&kp F11>;
            key-positions = <1 2 3>;
        };

        click-2 {
            bindings = <&mkp MB2>;
            key-positions = <20 19>;
            timeout-ms = <50>;
            layers = <4>;
        };

        click-3 {
            bindings = <&mkp MB3>;
            key-positions = <20 19 18>;
            timeout-ms = <50>;
            layers = <4>;
        };

        protect-gobaku {
            bindings = <&none>;
            key-positions = <22 23>;
            timeout-ms = <60>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        thumb_lt: thumb_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        home_l: home_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <300>;
            hold-trigger-on-release;
            require-prior-idle-ms = <80>;
        };

        home_r: home_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <300>;
            hold-trigger-key-positions = <41 40 39 38 37 0 1 2 3 4 10 11 12 13 14 22 23 24 25 26 34 35 36>;
            hold-trigger-on-release;
            require-prior-idle-ms = <100>;
        };

        // 新しいスクロール動作の追加

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        thumb_cmd: thumb_cmd {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_CMD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        home_shift_l: home_shift_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_SHIFT_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <300>;
            hold-trigger-key-positions = <5 6 7 8 9 17 18 19 20 21 29 30 31 32 33 41 42 40 39 38 37>;
            hold-trigger-on-release;
            require-prior-idle-ms = <60>;
        };

        home_shift_r: home_shift_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_SHIFT_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <300>;
            hold-trigger-key-positions = <41 40 39 38 37 0 1 2 3 4 10 11 12 13 14 22 23 24 25 26 34 35 36>;
            hold-trigger-on-release;
            require-prior-idle-ms = <60>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                &kp W               &kp E                   &kp R                       &kp T                                                                        &kp Y            &kp U                        &kp I                    &kp O                &kp P
&home_l LCTRL A      &home_l LEFT_ALT S  &home_l LEFT_COMMAND D  &home_shift_l LEFT_SHIFT F  &kp G                          &kp LS(LG(NUMBER_4))       &kp LA(SPACE)      &kp H            &home_shift_r RIGHT_SHIFT J  &home_r RIGHT_COMMAND K  &home_r RIGHT_ALT L  &kp SEMICOLON
&kp Z                &kp X               &kp C                   &kp V                       &kp B                          &kp LG(LS(Z))              &kp LG(V)          &kp N            &kp M                        &kp COMMA                &kp DOT              &kp SLASH
&mt LS(LGUI) ESCAPE  &kp LA(LEFT_GUI)    &kp LC(LG(LEFT_ALT))    &thumb_cmd LEFT_ALT TAB     &thumb_cmd LEFT_COMMAND SPACE  &thumb_lt 1 BACKSPACE      &thumb_lt 2 ENTER  &lt 3 LC(SPACE)                                                                             &kp ESC
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        SYMBOL {
            bindings = <
&trans        &kp AT_SIGN      &kp HASH           &kp DOLLAR  &none                                          &none         &kp AMPS   &kp LBRC  &kp RBRC  &kp PIPE
&kp COLON     &kp GRAVE        &kp DOUBLE_QUOTES  &kp SQT     &kp PERCENT  &trans             &kp LG(LS(P))  &kp PLUS      &kp MINUS  &kp LPAR  &kp RPAR  &kp EQUAL
&kp QUESTION  &kp EXCLAMATION  &kp CARET          &kp TILDE   &none        &kp LG(LS(F))      &kp LG(P)      &kp ASTERISK  &kp UNDER  &kp LBKT  &kp RBKT  &kp BSLH
&trans        &trans           &trans             &trans      &trans       &trans             &trans         &trans                                       &trans
            >;
        };

        NUM {
            bindings = <
&none                             &kp KP_NUMBER_7               &kp KP_NUMBER_8                   &kp KP_NUMBER_9             &none                        &kp PLUS      &kp N7  &kp N8  &kp N9  &kp MINUS
&home_l LEFT_CONTROL KP_NUMBER_0  &home_l LEFT_ALT KP_NUMBER_4  &home_l LEFT_COMMAND KP_NUMBER_5  &home_l LSHIFT KP_NUMBER_6  &kp DOT  &trans      &trans  &kp PERCENT   &kp N4  &kp N5  &kp N6  &kp N0
&kp KP_N0                         &kp KP_NUMBER_1               &kp KP_NUMBER_2                   &kp KP_NUMBER_3             &none    &trans      &trans  &kp ASTERISK  &kp N1  &kp N2  &kp N3  &kp N0
&trans                            &trans                        &trans                            &trans                      &trans   &trans      &trans  &kp DOT                               &trans
            >;
        };

        ARROW {
            bindings = <
&trans     &mkp MB4  &none     &mkp MB5   &trans                      &none     &kp LA(LEFT_ARROW)      &kp UP_ARROW    &kp LA(RIGHT_ARROW)      &none
&kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans  &trans      &trans  &kp HOME  &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END
&trans     &trans    &trans    &trans     &trans  &trans      &trans  &none     &kp LS(LG(LEFT_ARROW))  &none           &kp LS(LG(RIGHT_ARROW))  &trans
&trans     &trans    &trans    &mo 5      &trans  &trans      &trans  &trans                                                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans           &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans           &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans           &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &lt 3 LC(SPACE)                            &trans
            >;
        };

        Function {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none    &none                            &none   &none   &none   &none   &none
&kp F1        &kp F2        &kp F3        &kp F4   &kp F5   &none      &none        &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11       &kp F12       &kp F13       &kp F14  &kp F15  &none      &bootloader  &none   &none   &none   &none   &none
&bt BT_CLR    &none         &none         &none    &none    &none      &none        &none                           &bt BT_CLR_ALL
            >;
        };
    };
};
